	"item": [
		{
			"name": "sign In",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if(pm.response.code >= 200 && pm.response.code <= 299){",
							"    try {",
							"        var jsonData = pm.response.json();",
							"        pm.environment.set(\"access-Token\",jsonData.token);",
							"        pm.environment.set('refresh-Token', jsonData.refreshToken);",
							"    } catch (error) {",
							"        console.log(error);",
							"    }",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"userName\":\"fernando\",\n    \"password\":\"senhaSegura123\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url_base}}{{host}}/api/v1/auth/signin",
					"host": [
						"{{url_base}}{{host}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"signin"
					]
				}
			},
			"response": []
		},
